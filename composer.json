{
    "name": "hessuj/hessutalks",
    "description": "HessuTalks – päästä päähän salattu kysymys- ja palautekanava luennoille",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "lbuchs/webauthn": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "HessuTalks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HessuTalks\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        },
        "allow-plugins": {}
    },
    "scripts": {
        "test": [
            "phpunit"
        ],
        "stan": [
            "phpstan analyse --memory-limit=1G"
        ]
    }
}
